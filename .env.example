# Copy to .env.local. Values come from the Supabase project
# (Settings -> API). The StudEasy_ prefix is deliberate: the Supabase project
# is shared with other apps, so unprefixed names would collide.
#
# Both of these are safe in a browser bundle — the anon key only grants what
# row-level security allows.

NEXT_PUBLIC_StudEasy_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_StudEasy_SUPABASE_ANON_KEY=your-anon-public-key

# Absolute origin used in confirmation and password-reset emails, so production
# links never point at a preview deployment. Set this in Vercel for Production
# only. Omit locally.
NEXT_PUBLIC_SITE_URL=

# NOT used by this app, and must never be. The service_role and secret keys
# bypass row-level security entirely, so they cannot appear in anything that
# reaches a browser. They are listed here only so nobody adds them by mistake:
#   StudEasy_SUPABASE_SERVICE_ROLE_KEY
#   StudEasy_SUPABASE_SECRET_KEY
#   StudEasy_SUPABASE_JWT_SECRET
#   StudEasy_POSTGRES_* (direct database access)
