# Copy to .env.local. Values come from the Supabase project
# (Settings -> API). The StudEasy_ prefix is deliberate: the Supabase project
# is shared with other apps, so unprefixed names would collide.
#
# Both of these are safe in a browser bundle — the anon key only grants what
# row-level security allows.

NEXT_PUBLIC_StudEasy_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_StudEasy_SUPABASE_ANON_KEY=your-anon-public-key

# Absolute origin used in confirmation, password-reset and Stripe return links,
# so production never points at a preview deployment. Set in Vercel for
# Production only. Omit locally.
NEXT_PUBLIC_SITE_URL=

# --- Stripe -----------------------------------------------------------------
# Server-only. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Service role -----------------------------------------------------------
# Used by ONE thing: the Stripe webhook, which arrives with no user session and
# therefore has no row-level-security identity to act under. It bypasses RLS
# entirely, so it must never reach a browser and must never be NEXT_PUBLIC_.
StudEasy_SUPABASE_SERVICE_ROLE_KEY=

# NOT used by this app:
#   StudEasy_SUPABASE_SECRET_KEY
#   StudEasy_SUPABASE_JWT_SECRET
#   StudEasy_POSTGRES_*  (direct database access)
