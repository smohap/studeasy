# Copy to .env and fill in from your Supabase project (Settings -> API).
# Both values are safe to expose in a browser bundle: the anon key only grants
# what row-level security allows. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
